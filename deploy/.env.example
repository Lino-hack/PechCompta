# === PêchCompta — VPS OVHcloud ===
# Ne PAS committer le .env réel. Copie ce fichier :  cp .env.example .env
# puis remplis POSTGRES_PASSWORD (min 12 caractères).
#
# APP_KEY  : sera régénérée par setup-vps.sh — valeur par défaut, non utilisée en prod.
# SSLIP_HOST : sera rempli automatiquement par setup-vps.sh

POSTGRES_PASSWORD=CHANGEMOI_12_CARACTERES_MIN
APP_KEY=base64:WENEREGENERE_PAS_UTILISEE
SSLIP_HOST=REMPLACER_PAR_IP.sslip.io
FRONTEND_URL=https://pech-compta.vercel.app